@{
    Layout = null;
    var pageTitle = ViewData["Title"]?.ToString() ?? "Moipone Email";
    var heroBackground = ViewData["HeroBackground"]?.ToString() ?? "#116466";
}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>@pageTitle</title>
<link href="https://fonts.googleapis.com/css2?family=Lexend:wght@300;400;500;600;700&amp;family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300;1,400&amp;display=swap" rel="stylesheet">
<link rel="stylesheet" href="moipone-email.css">
</head>
<body>
<div class="email-wrapper">

  <div class="email-header">
    <div class="header-logo">
      <img src="https://www.moiponeacademy.org/images/moipone-logo.png" alt="Moipone">
    </div>
    <div class="header-tagline">Where ideas become<br>something more.</div>
  </div>

  <div class="email-hero" style="background-color:@heroBackground;">
    @RenderSection("Hero", required: true)
  </div>

  <div class="email-body">
    @RenderBody()
  </div>

  <div class="email-footer">
    <div class="footer-bottom">
      <div class="footer-address">
        &copy; 2026 Moipone &middot; All rights reserved<br>
        4/457 Andrew Maphetho Drive &, Thami Mnyele Dr&middot; Johannesburg &middot; South Africa
      </div>
    </div>
    <div class="footer-quote">Made with intention, built with care.</div>
  </div>

</div>
</body>
</html>
